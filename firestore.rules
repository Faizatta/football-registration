rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{kitNumber} {
      // Admin has full access
      allow read, write: if request.auth != null;

      // Anyone can check if a specific kit number exists
      allow get: if true;
      
      // Allow creation if the kit number doesn't exist and matches the document ID
      allow create: if request.resource.data.kitNumber == int(kitNumber) && !exists(/databases/$(database)/documents/players/$(kitNumber));
    }
  }
}
